%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: adfce7c91a8e007468508c325dde5902, type: 3}
  m_Name: MCHAT
  m_EditorClassIdentifier: Assembly-CSharp::Questionarios
  nomeQuestionario: MCHAT
  introducaoDoQuiz: "Este question\xE1rio cont\xE9m perguntas de Sim/N\xE3o. Aten\xE7\xE3o
    aos \xEDcones para pontuar corretamente: a op\xE7\xE3o N\xC3O \xE9 representada
    por um \"X\", e a op\xE7\xE3o SIM \xE9 representada por um sinal de positivo"
  listaPerguntas:
  - enunciado: "Se voc\xEA apontar para algum objeto no quarto, a sua crian\xE7a
      olha para este objeto? (POR EXEMPLO, se voc\xEA apontar para um brinquedo ou
      animal, a sua crian\xE7a olha para o brinquedo ou para o animal?) "
    imagemPergunta: {fileID: -8776159758478093870, guid: 23df9a34c7771f6448a5f6a6b0df0733, type: 3}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 1
    respostaAlerta: 1
  - enunciado: "Alguma vez voc\xEA se perguntou se a sua crian\xE7a pode ser surda? "
    imagemPergunta: {fileID: 3231845376359937049, guid: a14233468fa9f4f4bb11b73625c01ee0, type: 3}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 0
    respostaAlerta: 0
  - enunciado: ". A sua crian\xE7a brinca de faz de contas? (POR EXEMPLO, faz de
      conta que bebe em um copo vazio, faz de conta que fala ao telefone, faz de
      conta que d\xE1 comida a uma boneca ou a um bichinho de pel\xFAcia?) "
    imagemPergunta: {fileID: -8776159758478093870, guid: 23df9a34c7771f6448a5f6a6b0df0733, type: 3}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 1
    respostaAlerta: 1
  - enunciado: "A sua crian\xE7a gosta de subir nas coisas? (POR EXEMPLO, m\xF3veis,
      brinquedos em parques ou escadas) "
    imagemPergunta: {fileID: -8776159758478093870, guid: 23df9a34c7771f6448a5f6a6b0df0733, type: 3}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 1
    respostaAlerta: 1
  - enunciado: "A sua crian\xE7a faz movimentos estranhos com os dedos perto dos
      olhos? (POR EXEMPLO, mexe os dedos em frente aos olhos e fica olhando para
      os mesmos?) "
    imagemPergunta: {fileID: 3231845376359937049, guid: a14233468fa9f4f4bb11b73625c01ee0, type: 3}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 0
    respostaAlerta: 0
  - enunciado: "A sua crian\xE7a aponta com o dedo para pedir algo ou para conseguir
      ajuda? (POR EXEMPLO, aponta para um biscoito ou brinquedo fora do alcance dele?)"
    imagemPergunta: {fileID: -8776159758478093870, guid: 23df9a34c7771f6448a5f6a6b0df0733, type: 3}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 1
    respostaAlerta: 1
  - enunciado: "A sua crian\xE7a aponta com o dedo para mostrar algo interessante
      para voc\xEA? (POR EXEMPLO, aponta para um avi\xE3o no c\xE9u ou um caminh\xE3o
      grande na rua)"
    imagemPergunta: {fileID: -8776159758478093870, guid: 23df9a34c7771f6448a5f6a6b0df0733, type: 3}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 1
    respostaAlerta: 1
  - enunciado: "A sua crian\xE7a se interessa por outras crian\xE7as? (POR EXEMPLO,
      olha para outras crian\xE7as, sorri para elas ou se aproxima delas?) "
    imagemPergunta: {fileID: -8776159758478093870, guid: 23df9a34c7771f6448a5f6a6b0df0733, type: 3}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 1
    respostaAlerta: 1
  - enunciado: "A sua crian\xE7a traz coisas para mostrar para voc\xEA ou as segura
      para que voc\xEA as veja \u2013 n\xE3o para conseguir ajuda, mas apenas para
      compartilhar? (POR EXEMPLO, para mostrar uma flor, um bichinho de pel\xFAcia
      ou um caminh\xE3o de brinquedo)"
    imagemPergunta: {fileID: -8776159758478093870, guid: 23df9a34c7771f6448a5f6a6b0df0733, type: 3}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 1
    respostaAlerta: 1
  - enunciado: "A sua crian\xE7a responde quando voc\xEA o chama pelo nome? (POR
      EXEMPLO, ela olha para voc\xEA, fala ou emite algum som, ou para o que est\xE1
      fazendo quando voc\xEA a chama pelo nome?)"
    imagemPergunta: {fileID: -8776159758478093870, guid: 23df9a34c7771f6448a5f6a6b0df0733, type: 3}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 1
    respostaAlerta: 1
  - enunciado: "Quando voc\xEA sorri para a sua crian\xE7a, ela sorri de volta para
      voc\xEA? "
    imagemPergunta: {fileID: -8776159758478093870, guid: 23df9a34c7771f6448a5f6a6b0df0733, type: 3}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 1
    respostaAlerta: 1
  - enunciado: "A sua crian\xE7a fica muito incomodada com barulhos do dia a dia?
      (POR EXEMPLO, grita ou chora ao ouvir barulhos como os de liquidificador ou
      de m\xFAsica alta? "
    imagemPergunta: {fileID: -8776159758478093870, guid: 23df9a34c7771f6448a5f6a6b0df0733, type: 3}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 1
    respostaAlerta: 1
  - enunciado: "A sua crian\xE7a anda? "
    imagemPergunta: {fileID: -8776159758478093870, guid: 23df9a34c7771f6448a5f6a6b0df0733, type: 3}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 1
    respostaAlerta: 1
  - enunciado: "A sua crian\xE7a olha nos seus olhos quando voc\xEA est\xE1 falando
      ou brincando com ela, ou vestindo a roupa dela? "
    imagemPergunta: {fileID: -8776159758478093870, guid: 23df9a34c7771f6448a5f6a6b0df0733, type: 3}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 1
    respostaAlerta: 1
  - enunciado: "A sua crian\xE7a tenta imitar o que voc\xEA faz? (POR EXEMPLO, quando
      voc\xEA d\xE1 tchau, ou bate palmas, ou joga um beijo, ele repete o que voc\xEA
      faz?) "
    imagemPergunta: {fileID: 3231845376359937049, guid: a14233468fa9f4f4bb11b73625c01ee0, type: 3}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 0
    respostaAlerta: 0
  - enunciado: "Quando voc\xEA vira a cabe\xE7a para olhar para alguma coisa, a sua
      crian\xE7a olha ao redor para ver o que voc\xEA est\xE1 olhando? "
    imagemPergunta: {fileID: -8776159758478093870, guid: 23df9a34c7771f6448a5f6a6b0df0733, type: 3}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 1
    respostaAlerta: 1
  - enunciado: "A sua crian\xE7a tenta fazer voc\xEA olhar para ela? (POR EXEMPLO,
      ela olha para voc\xEA para ser elogiada/aplaudida) "
    imagemPergunta: {fileID: -8776159758478093870, guid: 23df9a34c7771f6448a5f6a6b0df0733, type: 3}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 1
    respostaAlerta: 1
  - enunciado: "A sua crian\xE7a compreende quando voc\xEA pede para ela fazer alguma
      coisa? (POR EXEMPLO, se voc\xEA n\xE3o apontar, a sua crian\xE7a entende quando
      voc\xEA pede: \u201Ccoloca o copo na mesa\u201D ou \u201Cliga a televis\xE3o\u201D)? "
    imagemPergunta: {fileID: -8776159758478093870, guid: 23df9a34c7771f6448a5f6a6b0df0733, type: 3}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 1
    respostaAlerta: 1
  - enunciado: "Quando acontece algo novo, a sua crian\xE7a olha para o seu rosto
      para ver como voc\xEA se sente sobre o que aconteceu? (POR EXEMPLO, se ela
      ouve um barulho estranho ou v\xEA algo engra\xE7ado, ou v\xEA um brinquedo
      novo, ser\xE1 que ela olharia para seu rosto?) "
    imagemPergunta: {fileID: -8776159758478093870, guid: 23df9a34c7771f6448a5f6a6b0df0733, type: 3}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 1
    respostaAlerta: 1
  - enunciado: "A sua crian\xE7a gosta de atividades de movimento? (POR EXEMPLO,
      ser balan\xE7ada ou pular em seus joelhos). "
    imagemPergunta: {fileID: -8776159758478093870, guid: 23df9a34c7771f6448a5f6a6b0df0733, type: 3}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 1
    respostaAlerta: 1
