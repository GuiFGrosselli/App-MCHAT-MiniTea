%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: adfce7c91a8e007468508c325dde5902, type: 3}
  m_Name: minitea
  m_EditorClassIdentifier: Assembly-CSharp::Questionarios
  nomeQuestionario: minitea
  introducaoDoQuiz: "Este question\xE1rio apresentar\xE1 v\xE1rias perguntas por
    p\xE1gina. Se a resposta para uma ou mais perguntas for positiva, selecione a
    alternativa SIM"
  listaPerguntas:
  - enunciado: "A crian\xE7a evita olhar diretamente nos olhos? Tem grande dificuldade
      em ter intera\xE7\xE3o com adultos ou pessoas da mesma idade (timidez exagerada)?
      Chega a ficar muito zangado ou desesperado com alguma tentativa de intera\xE7\xE3o
      com adultos ou pessoas da mesma idade? Mostra-se distante, ausente, como se
      n\xE3o percebesse ou n\xE3o importasse a outra pessoa? \xC9 muito dif\xEDcil
      conseguir a aten\xE7\xE3o da crian\xE7a?"
    imagemPergunta: {fileID: 0}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 0
    respostaAlerta: 0
  - enunciado: "A crian\xE7a tem dificuldade para imitar gestos simples, como bater
      palmas? Tem dificuldade ou muita demora para imitar sons? S\xF3 com muito est\xEDmulo
      a crian\xE7a imita gestos ou sons?"
    imagemPergunta: {fileID: 0}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 0
    respostaAlerta: 0
  - enunciado: "A crian\xE7a \xE0s vezes tem rea\xE7\xF5es emocionais aparentemente
      sem rela\xE7\xE3o com o que o que est\xE1 presente ou acontece \xE0 sua volta
      (ex: gritar, rir, sem motivo aparente)? Ou costuma ser indiferente a situa\xE7\xF5es
      em que se esperaria um rea\xE7\xE3o?"
    imagemPergunta: {fileID: 0}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 0
    respostaAlerta: 0
  - enunciado: "A crian\xE7a \xE9 muito desajeitada (descoordenada)? Apresenta movimentos
      repetitivos? Tem movimentos estranhos com os dedos das m\xE3os ou com o corpo?
      Costuma caminhar mais na ponta dos p\xE9s? Ocorre de agredir a si mesma (bater-se,
      morder-se, etc)?"
    imagemPergunta: {fileID: 0}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 0
    respostaAlerta: 0
  - enunciado: "A crian\xE7a brinca de forma estranha com objetos, diferente do que
      seria esperado (ex: sugando, batendo, arrastando, enfileirando)? Fixa a aten\xE7\xE3o
      somente em um aspecto ou parte do objeto ou brinquedo (ex: roda de carrinho)?
      Tem interesse restrito, ou seja, somente em um ou dois objetos? Mostra pouco
      interesse em brinquedos e objetos?"
    imagemPergunta: {fileID: 0}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 0
    respostaAlerta: 0
  - enunciado: "A crian\xE7a tem muita dificuldade em aceitar mudar o que est\xE1
      fazendo para passar para outra atividade? Fica zangada ou triste por mudan\xE7as
      simples (ex: lugar dos m\xF3veis, trajeto para escola)? Quando ocorrem mudan\xE7as
      bruscas mostra uma rea\xE7\xE3o intensa (\xE9 dif\xEDcil de acalmar)?"
    imagemPergunta: {fileID: 0}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 0
    respostaAlerta: 0
  - enunciado: "A crian\xE7a tem alguma forma estranha de olhar para alguns objetos
      (ex: de muito perto, para uma parte s\xF3 do objeto)? Apresenta momentos de
      olhar parado, para o nada, como se estivesse ausente? Evita constantemente
      olhar para objetos apresentados?"
    imagemPergunta: {fileID: 0}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 0
    respostaAlerta: 0
  - enunciado: "Parece que a crian\xE7a \xE0s vezes n\xE3o ouve direito ou n\xE3o
      atende quando chamada pelo nome? Tem rea\xE7\xF5es inesperadas (ex: crise de
      irritabilidade, tapar os ouvidos) quando ouve alguns sons do ambiente?"
    imagemPergunta: {fileID: 0}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 0
    respostaAlerta: 0
  - enunciado: "A crian\xE7a segue levando \xE0 boca objetos, mesmo que outras crian\xE7as
      da sua idade j\xE1 n\xE3o fa\xE7am mais isso? Tenta cheirar ou experimentar
      o gosto de objetos n\xE3o comest\xEDveis, e at\xE9 pessoas? Gosta de comer
      s\xF3 alguns alimentos espec\xEDficos, recusando-se a experimentar outros?
      A rea\xE7\xE3o a um est\xEDmulo doloroso \xE9 fora do normal: quase n\xE3o
      reage ou reage muito mais intensamente que o esperado?"
    imagemPergunta: {fileID: 0}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 0
    respostaAlerta: 0
  - enunciado: "Parece que a crian\xE7a muitas vezes tem medo ou nervosismo exagerado?
      Chega a ter medo de coisas inofensivas? Ou parece n\xE3o ter medo quando seria
      esperado que tivesse (ex: perto de um cachorro latindo, atravessar a rua)?
      Chega a ser dif\xEDcil acalmar a crian\xE7a nas crises de medo?"
    imagemPergunta: {fileID: 0}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 0
    respostaAlerta: 0
  - enunciado: "A crian\xE7a est\xE1 atrasada para falar? Tem uma fala estranha,
      na escolha dos sons ou palavras, nem sempre f\xE1cil de entender? Fica repetindo
      muito s\xF3 coisas que v\xEA na TV (ex: n\xFAmeros em ingl\xEAs)?"
    imagemPergunta: {fileID: 0}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 0
    respostaAlerta: 0
  - enunciado: "A crian\xE7a tem dificuldade em se comunicar por gestos? Tem dificuldade
      de entender os gestos ou as express\xF5es faciais que fazemos? Em vez de pegar
      algo ao seu alcance, puxa um adulto para pegar o objeto para ela?"
    imagemPergunta: {fileID: 0}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 0
    respostaAlerta: 0
  - enunciado: "A crian\xE7a tem inquietude maior que outras crian\xE7as da idade?
      Chega a n\xE3o conseguir parar quieta para fazer algo? Ou \xE9 muito parada,
      lenta, pregui\xE7osa perto de outras crian\xE7as da idade?"
    imagemPergunta: {fileID: 0}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 0
    respostaAlerta: 0
  - enunciado: "A crian\xE7a parece ser menos esperta para aprender as coisas em
      rela\xE7\xE3o \xE0s outras crian\xE7as? Tem dificuldade de aprender especificamente
      s\xF3 algumas coisas que outras da mesma idade j\xE1 sabem? Parece ser muito
      mais esperta em uma coisa espec\xEDfica do que as demais crian\xE7as da idade?"
    imagemPergunta: {fileID: 0}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 0
    respostaAlerta: 0
  - enunciado: "Voc\xEA acha que sua crian\xE7a tem algo de diferente do usual ou
      atrasado em rela\xE7\xE3o ao desenvolvimento, comparado com outras crian\xE7as?"
    imagemPergunta: {fileID: 0}
    alternativas:
    - SIM
    - "N\xC3O"
    respostaCorreta: 0
    respostaAlerta: 0
